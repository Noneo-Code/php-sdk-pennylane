{
    "name": "noneo/sdk-pennylane",
    "description": "SDK pour l'accès à l'API Pennylane",
    "type": "library",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "Noneo\\Sdk\\Pennylane\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Noneo\\Sdk\\Pennylane\\Tests\\": "tests/"
        }
    },
    "authors": [
        {
            "name": "Valentin Goulier",
            "email": "valentin.goulier@noneo.fr"
        },
        {
            "name": "Noneo",
            "email": "contact@noneo.fr"
        }
    ],
    "require": {
        "php": ">=8.4",
        "saloonphp/saloon": "^4",
        "saloonphp/pagination-plugin": "^2",
        "saloonphp/rate-limit-plugin": "^2"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0",
        "phpstan/phpstan": "^2.2",
        "friendsofphp/php-cs-fixer": "^3.0",
        "psr/simple-cache": "^3.0",
        "symfony/yaml": "^7.0"
    },
    "scripts": {
        "test": "phpunit",
        "stan": "phpstan analyse --memory-limit=1G",
        "cs": "php-cs-fixer fix --dry-run --diff",
        "check": [
            "@test",
            "@stan",
            "@cs"
        ]
    },
    "config": {
        "sort-packages": true
    }
}
