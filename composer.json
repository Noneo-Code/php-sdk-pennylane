{
    "name": "noneo/sdk-pennylane",
    "description": "SDK pour l'accès à l'API Pennylane",
    "type": "library",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "Noneo\\Sdk\\Pennylane\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Noneo\\Sdk\\Pennylane\\Tests\\": "tests/"
        }
    },
    "authors": [
        {
            "name": "Valentin Goulier",
            "email": "valentin.goulier@noneo.fr"
        },
        {
            "name": "Noneo",
            "email": "contact@noneo.fr"
        }
    ],
    "require": {
        "php": ">=8.3",
        "psr/simple-cache": "^3.0",
        "saloonphp/pagination-plugin": "^2",
        "saloonphp/rate-limit-plugin": "^2",
        "saloonphp/saloon": "^4"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0",
        "phpstan/phpstan": "^2.2",
        "friendsofphp/php-cs-fixer": "^3.0"
    },
    "suggest": {
        "phpunit/phpunit": "Nécessaire aux assertions de Noneo\\Sdk\\Pennylane\\Testing\\MockPennylane (^11)"
    },
    "scripts": {
        "test": "phpunit --testsuite=default",
        "test:integration": "phpunit --testsuite=integration",
        "stan": "phpstan analyse --memory-limit=1G",
        "cs": "php-cs-fixer fix --dry-run --diff",
        "schema": "php bin/schema-check.php",
        "check": [
            "@test",
            "@stan",
            "@cs",
            "@schema"
        ]
    },
    "scripts-descriptions": {
        "test": "Suite unitaire : ni réseau, ni jeton.",
        "test:integration": "Suite d'intégration contre l'API réelle ; s'ignore sans PENNYLANE_API_TOKEN.",
        "schema": "Confronte les fixtures et les enums du SDK aux schémas OpenAPI committés."
    },
    "config": {
        "sort-packages": true
    }
}
